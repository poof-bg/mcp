{
  "name": "@poof-bg/mcp",
  "version": "1.2.0",
  "description": "MCP server for the Poof background removal API. Supports both stdio and Cloudflare Worker remote MCP.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "poof-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write .",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "poof",
    "background-removal",
    "ai",
    "image-processing",
    "model-context-protocol"
  ],
  "author": "Poof <support@poof.bg>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poof-bg/mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "dotenv": "^16.4.7",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
